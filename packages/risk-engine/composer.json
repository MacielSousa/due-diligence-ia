{
    "name": "fornecedores/risk-engine",
    "description": "Motor de avaliação de risco de contratação de fornecedores usando LLM + regras determinísticas.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "RiskEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RiskEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
